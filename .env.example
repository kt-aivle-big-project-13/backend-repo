# ─────────────────────────────────────
#  로컬 개발용 템플릿
#  cp .env.example .env  후 값 수정
#  docker-compose 와 Spring 이 이 파일을 공유한다
# ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ──
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=1234

DB_URL=jdbc:postgresql://localhost:5432/audit
DB_USERNAME=audit
DB_PASSWORD=1234

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=0000

# ── JWT (HS256 : 32byte 이상 필수) ──
JWT_SECRET=local-dev-only-secret-change-me-at-least-32-bytes

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=admin

# ── AWS S3 ──
AWS_REGION=
AWS_S3_BUCKET=