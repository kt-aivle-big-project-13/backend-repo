# ─────────────────────────────────────
#  로컬 개발용 템플릿
#  cp .env.example .env  후 값 수정
#  docker-compose 와 Spring 이 이 파일을 공유한다
# ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ──
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=1234

DB_URL=jdbc:postgresql://localhost:5432/audit
DB_USERNAME=audit
DB_PASSWORD=1234

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=0000

# ── Mail ──
MAIL_USERNAME=구글메일주소
MAIL_PASSWORD=구글앱비밀번호

# ── 비밀번호 재설정할 Frontend 주소 ──
FRONTEND_URL=http://localhost:5173

# ── JWT (HS256 : 32byte 이상 필수) ──
JWT_SECRET=local-dev-only-secret-change-me-at-least-32-bytes

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=admin

# ── AWS S3 ──
AWS_REGION=
AWS_S3_BUCKET=

# ── MinIO (dev 전용 : S3 호환 로컬 스토리지) ──
MINIO_ROOT_USER=8자이상아이디
MINIO_ROOT_PASSWORD=8자이상비밀번호
MINIO_ENDPOINT=http://localhost:9000

# ── AI Server ──
AI_SERVER_ENABLED=false
AI_SERVER_BASE_URL=http://localhost:8000
AI_SERVER_CONNECT_TIMEOUT=3s
AI_SERVER_READ_TIMEOUT=120s

# ── Google reCAPTCHA ──
RECAPTCHA_SECRET_KEY=발급받은_비밀_키